{
  "name": "sunplayer",
  "version-string": "0.1.0",
  "builtin-baseline": "9d7f79f56ae1a9b4704d6a7fb8237e347a974133",
  "dependencies": [
    {
      "name": "cubeb",
      "platform": "windows | osx"
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "zlib"
      ]
    },
    {
      "name": "libplacebo",
      "default-features": false,
      "features": [
        "d3d11"
      ],
      "platform": "windows"
    },
    {
      "name": "libplacebo",
      "default-features": false,
      "features": [
        "vulkan"
      ],
      "platform": "osx"
    },
    "libass",
    {
      "name": "pkgconf",
      "host": true,
      "platform": "windows"
    },
    {
      "name": "moltenvk",
      "platform": "osx"
    }
  ]
}
